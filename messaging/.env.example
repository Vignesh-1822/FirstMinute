# FirstMinute messaging bridge (Photon Spectrum) — copy to .env and fill in.
#
# Leave everything blank to run in "disconnected" mode: the server still
# starts, GET /health reports connected:false, and POST /send / POST /group
# return 503 (the FastAPI backend treats that as "bridge absent" /
# simulated messaging — see docs/SPEC.md "Photon conversation flow").

# --- required for a live connection -----------------------------------
# Photon Cloud project credentials (create a project at https://app.photon.codes).
# These authenticate the Spectrum() client itself, regardless of channel.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# --- channel selection ---------------------------------------------------
# "imessage" (default) or "whatsapp".
PHOTON_CHANNEL=imessage

# --- imessage channel (optional) -----------------------------------------
# Leave all three blank to use the Photon Cloud-hosted iMessage number for
# your project (simplest — nothing else to run). Set all three only if
# you're pairing your OWN Mac + phone number via the self-hosted
# advanced-imessage relay (see @photon-ai/advanced-imessage /
# github.com/photon-hq/advanced-imessage-ts): address/token come from that
# relay's own setup, phone is the iMessage-enabled number it's driving.
PHOTON_IMESSAGE_ADDRESS=
PHOTON_IMESSAGE_TOKEN=
PHOTON_IMESSAGE_PHONE=

# --- whatsapp channel (required only when PHOTON_CHANNEL=whatsapp) -------
# From the Meta/WhatsApp Business developer console.
PHOTON_WHATSAPP_ACCESS_TOKEN=
PHOTON_WHATSAPP_PHONE_NUMBER_ID=
PHOTON_WHATSAPP_APP_SECRET=

# --- bridge <-> backend wiring --------------------------------------------
BACKEND_URL=http://localhost:8000
PORT=8787

# Retries for forwarding an inbound Photon message to BACKEND_URL before
# giving up on that one message (exponential backoff: baseMs * 2^attempt).
PHOTON_INBOUND_RETRIES=4
PHOTON_INBOUND_RETRY_BASE_MS=300
